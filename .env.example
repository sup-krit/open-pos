# Copy this file to backend/.env and frontend/.env.local (picking the variables each side needs)
# and fill in real values. Never commit the copies — only this .env.example is tracked.

# --- Supabase ---
SUPABASE_URL=                          # Supabase project URL
SUPABASE_ANON_KEY=                     # Supabase anon/public API key
SUPABASE_SERVICE_ROLE_KEY=             # Supabase service role key (backend only, keep secret)
SUPABASE_JWT_SECRET=                   # HS256 JWT secret from `npx supabase status` (local dev); not in any repo config file, copy it manually
DATABASE_URL=                          # direct Postgres connection string for the FastAPI backend (SQLAlchemy/asyncpg)

# --- Backend (FastAPI) ---
FRONTEND_ORIGIN=http://localhost:3000  # allowed origin for CORS

# --- Frontend (Next.js) ---
# NEXT_PUBLIC_ vars are exposed to the browser — keep secrets out of this group
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
